{
  "name": "@sanweb/sw-framework",
  "version": "1.0.0",
  "description": "Framework web nativo e sem dependencias: CSS modular, componentes acessiveis, transicoes de pagina via View Transitions API e efeitos SW-FX progressivos.",
  "keywords": [
    "framework",
    "css",
    "vanilla-js",
    "view-transitions",
    "accessibility",
    "zero-dependency"
  ],
  "author": "Sandro Web Solutions",
  "license": "MIT",
  "homepage": "https://sw.sanweb.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanweb-dev/sw-framework.git"
  },
  "bugs": {
    "url": "https://github.com/sanweb-dev/sw-framework/issues"
  },
  "main": "dist/sw.min.js",
  "style": "dist/sw.min.css",
  "files": [
    "dist/sw.min.css",
    "dist/sw.min.js",
    "dist/sw.config.css",
    "dist/fonts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "serve": "node tests/static-server.js",
    "test": "node --test tests/sw-framework.test.js",
    "test:browser": "playwright test",
    "verify": "npm run test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
